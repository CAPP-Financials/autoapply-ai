# ─── Database (Neon Postgres free tier) ────────────────────────────────
# Auto-set when you connect Neon via Vercel marketplace integration.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ─── Better Auth ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000

# ─── BYO-key vault encryption ──────────────────────────────────────────
# Symmetric key used by pgcrypto to encrypt user-supplied AI provider keys
# at rest. Generate with: openssl rand -base64 32
KEY_ENCRYPTION_KEY=change-me-to-32-byte-random-string

# ─── File storage (Vercel Blob, free 1GB on Hobby) ─────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── Rate limiting (Upstash Redis free tier) ───────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Bot defense (Cloudflare Turnstile free) ───────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Optional: OAuth providers besides magic link ──────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Optional: Sentry error tracking (free 5k/mo) ──────────────────────
SENTRY_DSN=

# ─── Optional: Email transport for magic links ─────────────────────────
# Resend (free 3k/mo) or any SMTP
RESEND_API_KEY=
EMAIL_FROM=noreply@autoapply.ai

# ─── Server-side defaults ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
